{
  "name": "droidbridge",
  "version": "1.2.1",
  "description": "Android control center powered by scrcpy",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "check": "node --check public/renderer.js && node src/jira.js && node src/hid-keyboard.js && node src/mirror-bridge.js",
    "prebuild:win": "powershell -NoProfile -ExecutionPolicy Bypass -File ./prepare-mirros.ps1",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "release:mac": "CSC_NAME=\"Zero Soft Company Limited (A4FZ48VKPF)\" electron-builder --mac --publish never",
    "notarize:mac": "set -a && . ./.notarize.env && set +a && npm run release:mac"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.droidbridge.app",
    "productName": "DroidBridge",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist*/**",
      "!bin/**",
      "!build-assets/**",
      "!docs/**",
      "!.omc/**",
      "!.notarize.env",
      "!MIRROS-NOTICE.txt",
      "!*.{md,bat,command,ps1}"
    ],
    "extraResources": [
      {
        "from": "bin/",
        "to": "bin/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "extraResources": [
        {
          "from": "build-assets/mirros",
          "to": "mirros",
          "filter": [
            "MirrOS.exe",
            "MirrOS-Source.zip"
          ]
        },
        {
          "from": "MIRROS-NOTICE.txt",
          "to": "mirros/MIRROS-NOTICE.txt"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true,
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "shortcutName": "안드로이드 미러링"
    },
    "mac": {
      "target": {
        "target": "dmg",
        "arch": [
          "x64",
          "arm64"
        ]
      },
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "extendInfo": {
        "CFBundleDisplayName": "안드로이드 미러링"
      }
    },
    "linux": {
      "target": "AppImage"
    },
    "publish": {
      "provider": "github",
      "owner": "mesudal",
      "repo": "android-mirroring",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "apk-mitm": "^1.3.0",
    "electron-updater": "^6.8.9",
    "node-forge": "^1.4.0",
    "ws": "^8.18.0"
  }
}
