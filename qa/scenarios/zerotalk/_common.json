      { "dev": "$dev", "do": "tap", "sel": { "textMatches": "^(앱 사용 중에만 허용|허용)$" }, "timeout": 4000, "optional": true },
      { "dev": "$dev", "do": "tap", "sel": { "textMatches": "^(앱 사용 중에만 허용|허용)$" }, "timeout": 4000, "optional": true },
      { "dev": "$dev", "do": "tap", "sel": { "textMatches": "^(앱 사용 중에만 허용|허용)$" }, "timeout": 4000, "optional": true },
      { "dev": "$dev", "do": "tap", "sel": { "textMatches": "^(앱 사용 중에만 허용|허용)$" }, "timeout": 4000, "optional": true }
    ],
    "앱 최초 설치 상태로 실행": [
      { "dev": "$dev", "do": "stop" },
      { "dev": "$dev", "do": "clearData" },
      { "dev": "$dev", "do": "launch" }
    ],
    "이메일 로그인": [
      { "dev": "$dev", "expect": "visible", "sel": { "text": "이메일 로그인" }, "timeout": 15000 },
      { "dev": "$dev", "do": "type", "sel": { "class": "EditText", "index": 0 }, "value": "$account.id" },
      { "dev": "$dev", "do": "type", "sel": { "class": "EditText", "index": 1 }, "value": "$account.password" },
      { "dev": "$dev", "do": "key", "key": "back", "optional": true },
      { "dev": "$dev", "do": "tap", "sel": { "text": "로그인" } }
    ]
  }
